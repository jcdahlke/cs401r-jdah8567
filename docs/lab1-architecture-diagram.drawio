        <mxCell id="lg_domain" value="SageMaker Domain" style="rounded=1;fillColor=#E6F6F3;strokeColor=#01A88D;dashed=1;html=1;align=left;verticalAlign=middle;labelPosition=right;verticalLabelPosition=middle;spacingLeft=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1">
