        <mxCell id="lg_e_colors" parent="1" style="text;html=1;fontSize=11;fontColor=#232F3E;align=left;verticalAlign=middle;" value="Arrow color = IAM identity:  &lt;font color=&quot;#232F3E&quot;&gt;&lt;b&gt;■ IAM user cs401r-lab&lt;/b&gt;&lt;/font&gt;   &lt;font color=&quot;#C925D1&quot;&gt;&lt;b&gt;■ northstar-dev-DataEngineer&lt;/b&gt;&lt;/font&gt;   &lt;font color=&quot;#DD344C&quot;&gt;&lt;b&gt;■ northstar-dev-MLEngineer&lt;/b&gt;&lt;/font&gt;" vertex="1">
